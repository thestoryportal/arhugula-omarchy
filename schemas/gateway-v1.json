{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline model gateway v1",
  "x-limits": {
    "request_bytes": 65536, "text_bytes": 32768, "text_response_bytes": 65536,
    "audio_response_bytes": 1048576, "depth": 8, "nodes": 4096,
    "history": 4096, "pcm_bytes": 480000
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "service": {"enum": ["llm", "evaluator", "tts"]},
    "code": {"enum": ["authentication", "identity", "invalid_request", "invalid_response", "unavailable", "provider_failed", "timeout", "canceled", "replay", "exhausted", "busy", "cleanup", "clock", "stale_catalog"]},
    "text": {"type": "string"},
    "member": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "llm_input": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "context", "candidates"],
      "properties": {"text": {"$ref": "#/$defs/text"}, "context": {"$ref": "#/$defs/text"},
        "candidates": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "text"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"}}
    },
    "evaluator_input": {
      "type": "object", "additionalProperties": false, "required": ["context", "candidates"],
      "properties": {"context": {"$ref": "#/$defs/text"}, "candidates": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/candidate"}}}
    },
    "tts_input": {
      "type": "object", "additionalProperties": false, "required": ["text", "voice"],
      "properties": {"text": {"type": "string", "minLength": 1}, "voice": {"$ref": "#/$defs/id"}}
    },
    "llm_output": {
      "type": "object", "additionalProperties": false, "required": ["text", "candidate_id"],
      "properties": {"text": {"$ref": "#/$defs/text"}, "candidate_id": {"$ref": "#/$defs/member"}}
    },
    "score": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "score"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "score": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "evaluator_output": {
      "type": "object", "additionalProperties": false, "required": ["scores", "selected_id"],
      "properties": {"scores": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/score"}}, "selected_id": {"$ref": "#/$defs/member"}}
    },
    "tts_output": {
      "type": "object", "additionalProperties": false, "required": ["pcm_b64", "sample_rate", "channels", "sample_width"],
      "properties": {"pcm_b64": {"type": "string", "minLength": 4}, "sample_rate": {"type": "integer", "const": 24000}, "channels": {"type": "integer", "const": 1}, "sample_width": {"type": "integer", "const": 2}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "request_id", "service", "provider_id", "model_version", "catalog_version", "budget_ms", "payload"],
      "properties": {
        "version": {"type": "integer", "const": 1}, "request_id": {"$ref": "#/$defs/id"},
        "service": {"$ref": "#/$defs/service"}, "provider_id": {"$ref": "#/$defs/id"},
        "model_version": {"$ref": "#/$defs/id"}, "catalog_version": {"$ref": "#/$defs/revision"},
        "budget_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "payload": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"service": {"const": "llm"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/llm_input"}}}},
        {"if": {"properties": {"service": {"const": "evaluator"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/evaluator_input"}}}},
        {"if": {"properties": {"service": {"const": "tts"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/tts_input"}}}}
      ]
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "request_id", "service", "provider_id", "model_version", "catalog_version", "status"],
      "properties": {
        "version": {"type": "integer", "const": 1}, "request_id": {"$ref": "#/$defs/id"},
        "service": {"$ref": "#/$defs/service"}, "provider_id": {"$ref": "#/$defs/id"},
        "model_version": {"$ref": "#/$defs/id"}, "catalog_version": {"$ref": "#/$defs/revision"},
        "status": {"enum": ["ok", "error"]}, "result": {"type": "object"}, "code": {"$ref": "#/$defs/code"}
      },
      "oneOf": [
        {"properties": {"status": {"const": "error"}}, "required": ["code"], "not": {"required": ["result"]}},
        {"properties": {"status": {"const": "ok"}}, "required": ["result"], "not": {"required": ["code"]},
          "allOf": [
            {"if": {"properties": {"service": {"const": "llm"}}}, "then": {"properties": {"result": {"$ref": "#/$defs/llm_output"}}}},
            {"if": {"properties": {"service": {"const": "evaluator"}}}, "then": {"properties": {"result": {"$ref": "#/$defs/evaluator_output"}}}},
            {"if": {"properties": {"service": {"const": "tts"}}}, "then": {"properties": {"result": {"$ref": "#/$defs/tts_output"}}}}
          ]}
      ]
    }
  }
}
